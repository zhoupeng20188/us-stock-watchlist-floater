{
  "manifest_version": 3,
  "name": "US Stock Watchlist Floater",
  "version": "1.0.0",
  "description": "Shows a floating US stock watchlist at the bottom-right of any page. A circle rotates through prices and percent changes; hover to expand for volume ratio, turnover and more.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "*://push2.eastmoney.com/*",
    "*://searchapi.eastmoney.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "us-stock-watchlist-floater@zhoupeng20188.github.io",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": []
      }
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Watchlist Settings"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
